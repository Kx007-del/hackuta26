# Local configuration
HOST=127.0.0.1
PORT=5174
# Optional: defaults to data/relays.sqlite relative to server working directory.
# DATABASE_PATH=C:/path/outside/OneDrive/hackuta26/relays.sqlite
# CLIP_DIRECTORY=C:/path/outside/OneDrive/hackuta26/clips

# Showcase scoring (server only; never commit a real key). Leave empty to score with game data only.
GEMINI_API_KEY=
# Optional override; check https://ai.google.dev/gemini-api/docs/models for a current video-capable model.
GEMINI_MODEL=
